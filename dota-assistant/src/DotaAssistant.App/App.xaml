<Application x:Class="DotaAssistant.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#FF1A1F2E"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#CC243044"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3D9B8F"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFE8EEF5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FF9AA8BC"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FFE0A050"/>
  </Application.Resources>
</Application>
