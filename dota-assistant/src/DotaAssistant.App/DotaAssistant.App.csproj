<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DotaAssistant.App</RootNamespace>
    <AssemblyName>DotaAssistant</AssemblyName>
    <Product>Помощник Dota 2</Product>
    <Description>V0.5: DXGI-захват + ROI/template matching героя и предметов.</Description>
    <!-- WinUI 3 blocked in cloud Linux scaffold; WPF is the approved fallback. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DotaAssistant.Capture\DotaAssistant.Capture.csproj" />
    <ProjectReference Include="..\DotaAssistant.Vision\DotaAssistant.Vision.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\**\*"
             Link="assets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
